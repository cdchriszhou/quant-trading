# Quant Trading — copy to .env and edit before production deploy
# 行情始终走真实接口（腾讯/东财）

# ── 安全（上线前必改）──
SECRET_KEY=please-change-to-a-long-random-string
DEBUG=false
ALLOW_REGISTER=false
SEED_DEMO_USERS=false
REQUIRE_STRONG_SECRET=true
# 空库首次启动会创建该管理员（已有用户则不会再创建）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password-10chars+
# 生产同域由后端 :8000 托管前端；若另有域名请改成实际 Origin
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# 数据库
DB_DRIVER=sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=change-me
# DB_NAME=quant_trading

# 账户默认模式: paper=模拟资金, live=真实券商
TRADING_MODE=paper
DEFAULT_CASH=1000000

# A股真实费率
COMMISSION_RATE=0.00025
MIN_COMMISSION=5
STAMP_DUTY_RATE=0.0005
TRANSFER_FEE_RATE=0.00001

# MiniQMT 实盘（可选）
ALLOW_LIVE_TRADING=false
BROKER_TYPE=qmt
QMT_MINI_PATH=
QMT_ACCOUNT_ID=

# 大模型接入（可选，用于资金匹配推荐参考）
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 大盘环境 / 板块（可选）
# AVG_PRICE_SYMBOL 仅填交易所代码如 000001.SH；空则用真实个股截面均价（推荐）
AVG_PRICE_SYMBOL=
MARKET_ENV_MAX_EXTENSION_PCT=8.0
MARKET_ENV_CAUTION_EXTENSION_PCT=5.0
SECTOR_TOP_N=10
SECTOR_CACHE_TTL=300
SECTOR_STALE_TTL=1800
